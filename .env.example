# ══════════════════════════════════════════════════════════════
# Trimly — Environment Variables Reference
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# ══════════════════════════════════════════════════════════════

# ── App ────────────────────────────────────────────────────────
# Base URL of this app — used for SSR API requests and emails.
# In local dev: http://localhost:3000
# In production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── MongoDB ────────────────────────────────────────────────────
# Required for ALL API routes — dashboard auth, bookings, shops.
# Local dev: mongodb://localhost:27017/trimly
# Atlas: mongodb+srv://user:password@cluster.example/trimly
MONGODB_URI=mongodb+srv://user:password@cluster.example/trimly

# ── Clerk Authentication (B2B Dashboard) ───────────────────────
# REQUIRED. The dashboard, barber sync, and all B2B routes
# depend on a valid Clerk instance.
#
# Get your keys from: https://dashboard.clerk.com → API Keys
# Format: pk_test_... / sk_test_... (development)
#         pk_live_... / sk_live_... (production)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk redirect URLs — used during OAuth and sign-in flows.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── B2C Customer Auth ──────────────────────────────────────────
# Secret used to sign/verify customer JWT tokens (OTP login).
# REQUIRED in both dev and production.
# Generate a long random string: openssl rand -base64 32
CUSTOMER_JWT_SECRET=replace-with-at-least-32-random-characters

# ── Stripe Payments ────────────────────────────────────────────
# Optional in local development if you don't test subscriptions.
# Required in production for billing and subscription features.
# Get keys from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Webhook secret — run: stripe listen --forward-to localhost:3000/api/v1/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Twilio (OTP SMS Verification) ─────────────────────────────
# Optional for local dev — OTP will still work but SMS won't send.
# Required in production for phone verification.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1...

# ── File Uploads ───────────────────────────────────────────────
# Current implementation writes to public/uploads locally.
# Switch to S3/R2/Cloudinary in production for persistent storage.
UPLOAD_STORAGE_DRIVER=local

# ── API Backend (if deployed separately) ──────────────────────
# Leave blank for monorepo — Next.js route handlers are used directly.
# Set only if you have a separate Express API deployment.
# NEXT_PUBLIC_API_URL=https://api.trimly.com/api/v1
